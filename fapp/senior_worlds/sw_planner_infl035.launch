<!-- PLAN_INFL.md variant of sw_planner.launch: obstacles_inflation 0.35 instead of 0.1. FAPP's sim_test.launch (unchanged values: start 0 0 1.5, flight_type 1 = goals on /goal_with_id, all planner
     settings from run_in_test.xml / adv_test.xml defaults) with only the map size set so that the senior's world fits
     (PLAN_SW.md): map_size_x / map_size_y from the arguments, map_size_z 3.0 as sim_test.launch. -->
<launch>
    <arg name="map_size_x" default="230.0"/>
    <arg name="map_size_y" default="50.0"/>
    <arg name="map_size_z" value=" 3.0"/>
    <arg name="odom_topic" value="visual_slam/odom" />
    <include file="$(find fapp_planner)/launch/include/run_in_test.xml">
        <arg name="drone_id" value="0"/>
        <arg name="init_x" value="0.0"/>
        <arg name="init_y" value="0.0"/>
        <arg name="init_z" value="1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="flight_type" value="1"/>
    </include>
    <!-- PLAN_INFL.md test only (not the original settings) -->
    <param name="/drone_0_fapp_planner_node/grid_map/obstacles_inflation" value="0.35"/>
</launch>
